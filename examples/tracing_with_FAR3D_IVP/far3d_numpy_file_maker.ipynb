   "source": [
    "import numpy as np\n",
    "from firm3d.saw.far3d import FAR3DParser"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bdf6e107",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Harmonics exported to far3d_firm3d_out\n"
     ]
    }
   ],
   "source": [
    "phi_file = \"./phi_0000\"\n",
    "\n",
    "eigenfrequency = 110  # kHz\n",
    "\n",
    "eigenvector = FAR3DParser.from_file(phi_file, eigenfrequency)\n",
    "\n",
    "eigenvector.export_to_numpy(\"far3d_firm3d_out\")"
   ]
  }
 ],
